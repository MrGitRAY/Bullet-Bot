{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bullet-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "TIMEZONE": "Asia/Tehran",
    "ALLOWED_USER_IDS": "[]"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bullet-bot",
      "database_id": "e99cd32e-56f2-4f7f-af1e-3fbeb730be2d",
      "migrations_dir": "migrations"
    }
  ]
}
