BOT_TOKEN=replace-with-token-from-BotFather
# Optional. Supports HTTP(S), SOCKS4, and SOCKS5; MTProto proxies are not supported.
# TELEGRAM_PROXY_URL=socks5://username:password@proxy-host:1080
DATABASE_URL=sqlite+aiosqlite:///./data/bullet.db
DEFAULT_LANGUAGE=fa
TIMEZONE=Asia/Tehran
LOG_LEVEL=INFO
# Empty allows everyone. For personal use set your numeric Telegram user ID.
ALLOWED_USER_IDS=[]
